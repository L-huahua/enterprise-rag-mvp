# 复制本文件为 .env 后填入真实值，.env 已在 .gitignore 中，不会被提交
# 默认配置为 DeepSeek（OpenAI 兼容接口，国内直连）

LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 备用模型：主服务限流或超时后自动切换（可留空）
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_FALLBACK_MODEL=glm-4-flash

# Agent 行为参数
AGENT_MAX_STEPS=24
AGENT_RUN_TIMEOUT=60
LLM_TIMEOUT=120
LLM_TEMPERATURE=0.2

# 计费单价（元 / 百万 token），仅用于交付材料中的费用统计
LLM_PRICE_INPUT=1.0
LLM_PRICE_OUTPUT=2.0
